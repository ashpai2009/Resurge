{
  "name": "resurge",
  "version": "0.1.0",
  "description": "Fault tolerance for coding agents. Your agents can stop. Your work doesn't.",
  "keywords": [
    "codex",
    "coding-agent",
    "supervisor",
    "fault-tolerance",
    "automation"
  ],
  "type": "module",
  "bin": {
    "resurge": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "setup": "node scripts/setup.js",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:codex": "RESURGE_TEST_REAL_CODEX=1 vitest run tests/compat",
    "resurge": "node dist/cli/index.js"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
